        // Состояние приложения
        let selectedBlock = null;
        let currentQuestions = [];
        let currentQuestionIndex = 0;
        let userAnswers = [];
        let correctCount = 0;
        let incorrectCount = 0;
        let timerInterval = null;
        let startTime = null;
        let answered = false;

        // Функции
        function selectBlock(block) {
            selectedBlock = block;
            document.querySelectorAll('.block-btn').forEach(btn => {
                btn.style.borderColor = '#e0e0e0';
                btn.style.background = 'white';
            });
            event.currentTarget.style.borderColor = '#667eea';
            event.currentTarget.style.background = '#f0f3ff';
            document.getElementById('startBtn').disabled = false;

            // Обновить максимальное количество вопросов
            let maxQuestions = 0;
            if (block === 0) maxQuestions = 110;
            else if (block === 1) maxQuestions = 40;
            else if (block === 2) maxQuestions = 40;
            else if (block === 3) maxQuestions = 30;
            
            document.getElementById('questionCount').max = maxQuestions;
            document.getElementById('questionCount').value = Math.min(20, maxQuestions);
        }

        function shuffleArray(array) {
            const newArray = [...array];
            for (let i = newArray.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
            }
            return newArray;
        }

        function startTest() {
            // Получить настройки
            const questionCount = parseInt(document.getElementById('questionCount').value);
            const shuffleQuestions = document.getElementById('shuffleQuestions').checked;
            const shuffleOptions = document.getElementById('shuffleOptions').checked;

            // Подготовить вопросы
            let allQuestions = [];
            if (selectedBlock === 0) {
                allQuestions = [...questionsBlock1, ...questionsBlock2, ...questionsBlock3];
            } else if (selectedBlock === 1) {
                allQuestions = [...questionsBlock1];
            } else if (selectedBlock === 2) {
                allQuestions = [...questionsBlock2];
            } else if (selectedBlock === 3) {
                allQuestions = [...questionsBlock3];
            }

            // Перемешать вопросы если нужно
            if (shuffleQuestions) {
                allQuestions = shuffleArray(allQuestions);
            }

            // Выбрать нужное количество
            currentQuestions = allQuestions.slice(0, questionCount);

            // Перемешать варианты ответов если нужно
            if (shuffleOptions) {
                currentQuestions = currentQuestions.map(q => {
                    const correctAnswer = q.options[q.correct];
                    const shuffledOptions = shuffleArray([...q.options]);
                    const newCorrectIndex = shuffledOptions.indexOf(correctAnswer);
                    return {
                        ...q,
                        options: shuffledOptions,
                        correct: newCorrectIndex
                    };
                });
            }

            // Сбросить состояние
            currentQuestionIndex = 0;
            userAnswers = new Array(currentQuestions.length).fill(null);
            correctCount = 0;
            incorrectCount = 0;
            answered = false;

            // Показать экран теста
            document.getElementById('menu-screen').classList.add('hidden');
            document.getElementById('test-screen').classList.remove('hidden');

            // Запустить таймер
            startTime = Date.now();
            timerInterval = setInterval(updateTimer, 1000);

            // Показать первый вопрос
            showQuestion();
        }

        function updateTimer() {
            const elapsed = Math.floor((Date.now() - startTime) / 1000);
            const minutes = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const seconds = (elapsed % 60).toString().padStart(2, '0');
            document.getElementById('timer').textContent = `${minutes}:${seconds}`;
        }

        function showQuestion() {
            const question = currentQuestions[currentQuestionIndex];
            answered = userAnswers[currentQuestionIndex] !== null;

            // Обновить информацию
            document.getElementById('questionNumber').textContent = 
                `Вопрос ${currentQuestionIndex + 1} из ${currentQuestions.length}`;
            document.getElementById('blockInfo').textContent = `Блок ${question.block}`;
            document.getElementById('progress').style.width = 
                `${((currentQuestionIndex + 1) / currentQuestions.length) * 100}%`;

            // Показать текст вопроса
            document.getElementById('questionText').textContent = question.question;

            // Показать варианты
            const container = document.getElementById('optionsContainer');
            container.innerHTML = '';
            
            const letters = ['А', 'Б', 'В', 'Г'];
            question.options.forEach((option, index) => {
                const div = document.createElement('div');
                div.className = 'option';
                div.innerHTML = `
                    <div class="option-letter">${letters[index]}</div>
                    <div class="option-text">${option}</div>
                `;
                
                if (answered) {
                    if (index === question.correct) {
                        div.classList.add('correct');
                    } else if (userAnswers[currentQuestionIndex] === index) {
                        div.classList.add('incorrect');
                    }
                } else {
                    div.onclick = () => selectAnswer(index);
                }
                
                container.appendChild(div);
            });

            // Показать/скрыть feedback
            const feedback = document.getElementById('feedback');
            if (answered && document.getElementById('showFeedback').checked) {
                feedback.classList.add('show');
                if (userAnswers[currentQuestionIndex] === question.correct) {
                    feedback.className = 'feedback show correct';
                    feedback.textContent = '✓ Правильно!';
                } else {
                    feedback.className = 'feedback show incorrect';
                    feedback.textContent = `✗ Неправильно. Правильный ответ: ${letters[question.correct]}) ${question.options[question.correct]}`;
                }
            } else {
                feedback.classList.remove('show');
            }

            // Обновить кнопки навигации
            document.getElementById('prevBtn').disabled = currentQuestionIndex === 0;
            document.getElementById('skipBtn').style.display = answered ? 'none' : 'inline-block';
            document.getElementById('nextBtn').textContent = 
                currentQuestionIndex === currentQuestions.length - 1 ? 'Завершить' : 'Далее →';

            // Обновить статистику
            document.getElementById('correctCount').textContent = correctCount;
            document.getElementById('incorrectCount').textContent = incorrectCount;
        }

        function selectAnswer(index) {
            if (answered) return;

            const question = currentQuestions[currentQuestionIndex];
            userAnswers[currentQuestionIndex] = index;
            answered = true;

            if (index === question.correct) {
                correctCount++;
            } else {
                incorrectCount++;
            }

            showQuestion();
        }

        function nextQuestion() {
            if (currentQuestionIndex === currentQuestions.length - 1) {
                finishTest();
            } else {
                currentQuestionIndex++;
                answered = userAnswers[currentQuestionIndex] !== null;
                showQuestion();
            }
        }

        function previousQuestion() {
            if (currentQuestionIndex > 0) {
                currentQuestionIndex--;
                answered = userAnswers[currentQuestionIndex] !== null;
                showQuestion();
            }
        }

        function skipQuestion() {
            nextQuestion();
        }

        function finishTest() {
            clearInterval(timerInterval);

            const totalQuestions = currentQuestions.length;
            const answeredCount = userAnswers.filter(a => a !== null).length;
            const unansweredCount = totalQuestions - answeredCount;
            
            // Пересчитать правильные и неправильные
            correctCount = 0;
            incorrectCount = 0;
            userAnswers.forEach((answer, index) => {
                if (answer !== null) {
                    if (answer === currentQuestions[index].correct) {
                        correctCount++;
                    } else {
                        incorrectCount++;
                    }
                }
            });

            const percentage = Math.round((correctCount / totalQuestions) * 100);

            // Показать результаты
            document.getElementById('test-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            document.getElementById('resultScore').textContent = `${percentage}%`;
            document.getElementById('finalCorrect').textContent = correctCount;
            document.getElementById('finalIncorrect').textContent = incorrectCount + unansweredCount;
            document.getElementById('finalTime').textContent = document.getElementById('timer').textContent;

            // Оценка результата
            let resultText = '';
            if (percentage >= 90) {
                resultText = '🏆 Отлично! Вы прекрасно подготовлены!';
            } else if (percentage >= 75) {
                resultText = '👍 Хороший результат! Есть небольшие пробелы.';
            } else if (percentage >= 60) {
                resultText = '📚 Удовлетворительно. Рекомендуем повторить материал.';
            } else {
                resultText = '📖 Нужно больше практики. Изучите теорию заново.';
            }
            document.getElementById('resultText').textContent = resultText;
        }

        function reviewAnswers() {
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('review-screen').classList.remove('hidden');

            const container = document.getElementById('reviewContainer');
            container.innerHTML = '';

            const letters = ['А', 'Б', 'В', 'Г'];

            currentQuestions.forEach((question, qIndex) => {
                const userAnswer = userAnswers[qIndex];
                const isCorrect = userAnswer === question.correct;
                const isUnanswered = userAnswer === null;

                const div = document.createElement('div');
                div.style.marginBottom = '25px';
                div.style.padding = '15px';
                div.style.borderRadius = '10px';
                div.style.background = isUnanswered ? '#fff3e0' : (isCorrect ? '#e8fff0' : '#fff0f0');
                div.style.border = `1px solid ${isUnanswered ? '#ff9800' : (isCorrect ? '#38ef7d' : '#f45c43')}`;

                let answersHtml = question.options.map((opt, i) => {
                    let style = '';
                    let icon = '';
                    if (i === question.correct) {
                        style = 'color: #0d6832; font-weight: 600;';
                        icon = ' ✓';
                    }
                    if (userAnswer === i && i !== question.correct) {
                        style = 'color: #a71d2a; text-decoration: line-through;';
                        icon = ' ✗';
                    }
                    return `<div style="${style}">${letters[i]}) ${opt}${icon}</div>`;
                }).join('');

                div.innerHTML = `
                    <div style="font-weight: 600; margin-bottom: 10px; color: #333;">
                        ${qIndex + 1}. ${question.question}
                    </div>
                    <div style="margin-left: 15px; font-size: 0.95rem;">
                        ${answersHtml}
                    </div>
                    <div style="margin-top: 10px; font-size: 0.85rem; color: #666;">
                        ${isUnanswered ? '⚠️ Без ответа' : (isCorrect ? '✓ Правильно' : '✗ Неправильно')}
                        | Блок ${question.block}
                    </div>
                `;

                container.appendChild(div);
            });
        }

        function goToResults() {
            document.getElementById('review-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');
        }

        function restartTest() {
            document.getElementById('result-screen').classList.add('hidden');
            startTest();
        }

        function goToMenu() {
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('review-screen').classList.add('hidden');
            document.getElementById('menu-screen').classList.remove('hidden');
            
            // Сбросить выбор блока
            selectedBlock = null;
            document.querySelectorAll('.block-btn').forEach(btn => {
                btn.style.borderColor = '#e0e0e0';
                btn.style.background = 'white';
            });
            document.getElementById('startBtn').disabled = true;
        }
    </script>
</body>
</html>

